<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:PlotThoseLines.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:PlotThoseLines.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:myclass="using:PlotThoseLines.MyClass"
  xmlns:scottplot="using:ScottPlot"
  mc:Ignorable="d"
  d:DesignWidth="800"
  d:DesignHeight="450"
  x:Class="PlotThoseLines.Views.MainWindow"
  x:DataType="vm:MainViewModel"
  xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
  Icon="/Assets/avalonia-logo.ico"
  Title="PlotThoseLines"
>
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- En-tête -->
    <Border Grid.Row="0" Padding="12" Background="#252526">
      <StackPanel
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Orientation="Horizontal"
        Spacing="8"
      >
        <TextBlock>Plot those lines</TextBlock>

        <Button Content="Listes">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding Listes}">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme
                  TargetType="MenuItem"
                  BasedOn="{StaticResource {x:Type MenuItem}}"
                  x:DataType="myclass:ListeMenuItem"
                >
                  <Setter Property="Header" Value="{Binding Nom}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Content="Ajouter une liste" Click="OnAddList" />
        <Button Content="Aide" />
      </StackPanel>
    </Border>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding ColumnToggles}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>

      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ColumnToggle">
          <ToggleButton
            Content="{Binding Name}"
            IsChecked="{Binding IsVisible, Mode=TwoWay}"
            Margin="0,0,8,8"
            MinWidth="90"
            CornerRadius="16"
            Background="#263449"
            BorderBrush="#465A73"
            BorderThickness="1"
            Foreground="#DCE6F2"
          >
            <ToggleButton.Styles>
              <Style Selector="ToggleButton:checked">
                <Setter Property="Background" Value="#2878D0" />
                <Setter Property="BorderBrush" Value="#55A6FF" />
                <Setter Property="Foreground" Value="White" />
              </Style>

              <Style Selector="ToggleButton:pointerover">
                <Setter Property="BorderBrush" Value="#8CC5FF" />
              </Style>
            </ToggleButton.Styles>
          </ToggleButton>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Graphique -->
    <ScottPlot:AvaPlot Grid.Row="2" Name="AvaPlot1" />
  </Grid>
</Window>
