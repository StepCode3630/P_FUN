<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:PlotThoseLines.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:PlotThoseLines.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:myclass="using:PlotThoseLines.MyClass"
  xmlns:scottplot="using:ScottPlot"
  mc:Ignorable="d"
  d:DesignWidth="800"
  d:DesignHeight="450"
  x:Class="PlotThoseLines.Views.MainWindow"
  x:DataType="vm:MainViewModel"
  xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
  Icon="/Assets/avalonia-logo.ico"
  Title="PlotThoseLines"
>
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>
  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Border Grid.Row="0" Padding="12" Background="#252526">
      <StackPanel
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Orientation="Horizontal"
        Spacing="8"
      >
        <TextBlock>Plot those lines</TextBlock>

        <Button Content="Listes">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding Listes}">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme
                  TargetType="MenuItem"
                  BasedOn="{StaticResource {x:Type MenuItem}}"
                  x:DataType="myclass:ListeMenuItem"
                >
                  <Setter Property="Header" Value="{Binding Nom}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Content="Aide" />
      </StackPanel>
    </Border>

    <!-- Graphique ScottPlot -->
    <ScottPlot:AvaPlot Grid.Row="1" Name="AvaPlot1" />
  </Grid>
</Window>
