<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="800"
  d:DesignHeight="450"
  x:Class="PlotThoseLines.Views.PlotOptionsWindow"
  Title="PlotOptionsWindow"
>
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="Nom du graphique" />
    <TextBox Name="PlotNameTextBox" PlaceholderText="Years" />
    <TextBlock Text="Axe X" />
    <ComboBox Name="XColumnComboBox" />
<!--    <TextBlock Text="Axe Y" />
    <ComboBox Name="YColumnComboBox" />-->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
      <Button Content="Annuler" Click="CancelOptions_Click" />
      <Button Content="Valider" Click="ValidateOptions_Click" />
    </StackPanel>
  </StackPanel>
</Window>
